#!/usr/bin/env bash
set -euo pipefail

usage() {
  echo 'Usage: nocapture [show|hide|stop|status|doctor|--help]'
  echo 'Without arguments, toggle the Noctalia capture toolbar.'
}

if (($# > 1)); then
  usage >&2
  exit 2
fi

action=${1:-toggle}
case "$action" in
--help | -h)
  usage
  exit 0
  ;;
toggle | show | hide | stop | status | doctor) ;;
*)
  usage >&2
  exit 2
  ;;
esac

if ! command -v noctalia >/dev/null 2>&1; then
  echo 'nocapture: Noctalia v5 must be installed and running.' >&2
  exit 1
fi

case "$action" in
toggle) exec noctalia msg panel-toggle hackrdotsh/nocapture:toolbar ;;
show) exec noctalia msg panel-open hackrdotsh/nocapture:toolbar ;;
hide) exec noctalia msg panel-close hackrdotsh/nocapture:toolbar ;;
stop | status) exec nocapture-engine "$action" ;;
doctor)
  noctalia --version
  plugins=$(noctalia msg plugins list)
  failed=0
  if grep -Eq '^hackrdotsh/nocapture .* enabled$' <<<"$plugins"; then
    echo 'hackrdotsh/nocapture: enabled'
  else
    echo 'hackrdotsh/nocapture: not enabled' >&2
    failed=1
  fi
  if command -v nocapture-engine >/dev/null 2>&1; then
    echo 'nocapture-engine: available'
  else
    echo 'nocapture-engine: missing' >&2
    failed=1
  fi
  exit "$failed"
  ;;
esac
